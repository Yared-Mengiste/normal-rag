# Copy to .env. Values are read only from that file, not inherited shell settings.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Required: one OpenRouter provider slug, e.g. openai. No fallback routing.
OPENROUTER_PROVIDER=
TEMPERATURE=0.1
MAX_TOKENS=256
TIMEOUT_SECONDS=60
OLLAMA_URL=http://127.0.0.1:11434/api/embeddings
EMBEDDING_TIMEOUT_SECONDS=30
