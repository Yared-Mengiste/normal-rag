# Standalone three-world pilot settings: copy to .env for pilot/check commands.
# For the shared 40-question benchmark, configure ../rule-chain-depth/.env instead.
# The benchmark command uses OPENAI_API_KEY, OPENAI_MODEL, and B1_* settings there.
# Pilot settings below are read only from this file, not inherited shell settings.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Required: one OpenRouter provider slug, e.g. openai. No fallback routing.
OPENROUTER_PROVIDER=
TEMPERATURE=0.1
MAX_TOKENS=256
TIMEOUT_SECONDS=60
OLLAMA_URL=http://127.0.0.1:11434/api/embeddings
EMBEDDING_TIMEOUT_SECONDS=30
